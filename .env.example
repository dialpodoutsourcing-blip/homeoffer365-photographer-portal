# Copy to .env.local. These are browser-safe project settings, not secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only credentials for the public photographer submission endpoint.
# Never prefix the secret key with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SB_SECRET=
# Optional locally; configure for public guest access and enable matching CAPTCHA in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
